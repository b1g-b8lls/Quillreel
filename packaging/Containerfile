# Build environment for Quillreel's release packages (see packaging/README.md).
# BASE is the distro the packages are built on: Debian 13 (the oldest mainstream
# base with FFmpeg 7.1+, Qt 6 and SDL3; also used for the AppImage) or Ubuntu 26.04.
ARG BASE=docker.io/library/debian:trixie
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config \
        libavformat-dev libavcodec-dev libavfilter-dev libavutil-dev libswscale-dev libswresample-dev \
        libsdl3-dev \
        qt6-base-dev qt6-base-dev-tools qmake6 qt6-multimedia-dev qt6-wayland \
        qt6-gtk-platformtheme qt6-xdgdesktopportal-platformtheme \
        dpkg-dev file patchelf ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

# linuxdeploy and its Qt plugin build the AppImage. They are AppImages themselves;
# containers have no FUSE, so they run with APPIMAGE_EXTRACT_AND_RUN=1.
ARG LINUXDEPLOY=https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage
ARG LINUXDEPLOY_QT=https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage
RUN wget -q -O /usr/local/bin/linuxdeploy "$LINUXDEPLOY" \
    && wget -q -O /usr/local/bin/linuxdeploy-plugin-qt "$LINUXDEPLOY_QT" \
    && chmod +x /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-qt \
    && sha256sum /usr/local/bin/linuxdeploy /usr/local/bin/linuxdeploy-plugin-qt > /usr/local/share/linuxdeploy.sha256
