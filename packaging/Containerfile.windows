# Build environment for Quillreel's Windows installer (see packaging/README.md).
# Cross-compiles on Linux: Arch's mingw-w64 GCC (targets UCRT with POSIX threads,
# the same as MSYS2's UCRT64 environment) against MSYS2's prebuilt Windows
# FFmpeg, SDL3 and Qt 6, installed into /opt/msys by pacman.

# NSIS's makensis runs on Linux; Arch doesn't package it, so take Debian's.
FROM docker.io/library/debian:trixie AS nsis
RUN apt-get update && apt-get install -y --no-install-recommends nsis && rm -rf /var/lib/apt/lists/*

FROM docker.io/library/archlinux:latest
RUN pacman -Syu --noconfirm --needed \
        make pkgconf mingw-w64-gcc mingw-w64-binutils qt6-base git ca-certificates curl zip \
    && pacman -Scc --noconfirm

COPY --from=nsis /usr/bin/makensis /usr/local/bin/makensis
COPY --from=nsis /usr/share/nsis /usr/share/nsis

# MSYS2's packages are signed; trust MSYS2's keys (from their keyring repository)
# so pacman checks every package, whichever mirror serves it.
ARG MSYS2_KEYRING=https://raw.githubusercontent.com/msys2/MSYS2-keyring/master
RUN pacman-key --init \
    && for f in msys2.gpg msys2-trusted msys2-revoked; do \
         curl -fsSL -o /usr/share/pacman/keyrings/$f "$MSYS2_KEYRING/$f" || exit 1; \
       done \
    && pacman-key --populate msys2

COPY pacman-msys2.conf /etc/pacman-msys2.conf
ARG MSYS2_PACKAGES="ffmpeg sdl3 qt6-base"
RUN mkdir -p /opt/msys/var/lib/pacman \
    && pacman --config /etc/pacman-msys2.conf --root /opt/msys --dbpath /opt/msys/var/lib/pacman \
        -Sy --noconfirm --noscriptlet --disable-download-timeout $(printf 'mingw-w64-ucrt-x86_64-%s ' $MSYS2_PACKAGES) \
    && pacman --config /etc/pacman-msys2.conf --root /opt/msys --dbpath /opt/msys/var/lib/pacman -Scc --noconfirm

ENV MSYS_ROOT=/opt/msys/ucrt64
